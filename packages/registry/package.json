{
  "name": "@hookforge/registry",
  "version": "1.0.0",
  "description": "Machine-readable manifests for every HookForge Uniswap v4 hook: permissions, parameters, prior art, and deterministic addresses on every chain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./hooks/*": "./hooks/*",
    "./index.json": "./index.json"
  },
  "files": ["dist", "hooks", "index.json", "chains.json", "schema"],
  "keywords": ["uniswap", "uniswap-v4", "hooks", "defi", "amm", "registry", "ethereum", "base", "arbitrum"],
  "repository": { "type": "git", "url": "https://github.com/nirholas/hookforge.git", "directory": "packages/registry" },
  "scripts": {
    "generate": "node scripts/build.mjs",
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
