        "type": "uint128"
      }
    ]
  },
  "errors": [
    {
      "signature": "CallbackNotPoolManager()",
      "notice": "Only the `PoolManager` may drive the unlock callback. Named distinctly because `BaseHook` declares its own."
    },
    {
      "signature": "DepositTooSmall(uint128)",
      "notice": "The deposit is below the pool's minimum, which would leave the lease with no runway."
    },
    {
      "signature": "FeeTooHigh(uint24)",
      "notice": "The fee asked for is above what this pool allows a leaseholder to charge."
    },
    {
      "signature": "HookFeeTooLarge()",
      "notice": "Fee is higher than the maximum allowed fee."
    },
    {
      "signature": "HookNotImplemented()",
      "notice": "The hook function is not implemented."
    },
    {
      "signature": "InvalidMaxFee()",
      "notice": "The ceiling on a leaseholder's fee must itself be below the protocol maximum."
    },
    {
      "signature": "InvalidPool()",
      "notice": "The pool is not configured to use this hook."
    },
    {
      "signature": "InvalidRangeWidth()",
      "notice": "A range narrower than the tick spacing, or not a whole number of them, cannot be a range."
    },
    {
      "signature": "InvalidRentRate()",
      "notice": "A rent of zero is not a Harberger tax, and one above the whole valuation per day is confiscation."
    },
    {
      "signature": "InvalidValuation()",
      "notice": "A valuation of zero would make the lease free to take and free to hold, which is not a lease."
    },
    {
      "signature": "NothingToDo()",
      "notice": "There is nothing to settle or withdraw."
    },
    {
      "signature": "PoolAlreadyInitialized()",
      "notice": "The pool already exists, so its configuration is final."
    },
    {
      "signature": "PoolNotConfigured()",
      "notice": "The pool was initialized without a configuration for this hook."
    },
    {
      "signature": "SafeERC20FailedOperation(address)",
      "notice": "An operation with an ERC-20 token failed."
    }
  ],
