        "type": "bool"
      }
    ]
  },
  "errors": [
    {
      "signature": "BelowFloor(uint256,uint256)",
      "notice": "The swap would buy below the price the schedule is currently asking."
    },
    {
      "signature": "FloorAboveStart()",
      "notice": "The floor must not be above the start price; a schedule that ascends is not a Dutch auction."
    },
    {
      "signature": "HookNotImplemented()",
      "notice": "The hook function is not implemented."
    },
    {
      "signature": "InvalidDuration()",
      "notice": "`duration` was zero, which would make the schedule a single instant."
    },
    {
      "signature": "InvalidPool()",
      "notice": "The pool is not configured to use this hook."
    },
    {
      "signature": "PoolAlreadyInitialized()",
      "notice": "The pool already exists, so its configuration is final."
    },
    {
      "signature": "PoolNotConfigured()",
      "notice": "The pool was initialized without a configuration for this hook."
    },
    {
      "signature": "StartInThePast()",
      "notice": "The schedule must begin at or after configuration; a descent that already happened is not a schedule."
    }
  ],
