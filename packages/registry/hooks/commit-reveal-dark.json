        "type": "uint128"
      }
    ]
  },
  "errors": [
    {
      "signature": "AlreadyCommitted()",
      "notice": "This commitment already exists. Vary the salt."
    },
    {
      "signature": "Expired(uint256)",
      "notice": "The commitment has expired and its bond is forfeited."
    },
    {
      "signature": "HookNotImplemented()",
      "notice": "The hook function is not implemented."
    },
    {
      "signature": "InvalidDelay()",
      "notice": "A delay of zero would let somebody commit and reveal in the same block, which is no protection at all."
    },
    {
      "signature": "InvalidPool()",
      "notice": "The pool is not configured to use this hook."
    },
    {
      "signature": "InvalidTtl()",
      "notice": "The time to live must exceed the delay, or a commitment expires before it may be used."
    },
    {
      "signature": "NotCommitted(bytes32)",
      "notice": "The swap does not match any standing commitment."
    },
    {
      "signature": "NotExpiredYet(uint256)",
      "notice": "The commitment has not expired, so its bond cannot be swept."
    },
    {
      "signature": "NothingToWithdraw()",
      "notice": "There is nothing to withdraw."
    },
    {
      "signature": "PoolAlreadyInitialized()",
      "notice": "The pool already exists, so its configuration is final."
    },
    {
      "signature": "PoolNotConfigured()",
      "notice": "The pool was initialized without a configuration for this hook."
    },
    {
      "signature": "TooSoon(uint256)",
      "notice": "The commitment is not old enough to be revealed yet."
    },
    {
      "signature": "WrongBond(uint256)",
      "notice": "The bond sent does not match what the pool requires."
    }
  ],
