{
  "name": "hookforge",
  "private": true,
  "version": "1.0.0",
  "description": "50 production Uniswap v4 hooks: novel AMM mechanisms, a TypeScript SDK, an MCP server for agents, and a 3D catalogue.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/hookforge.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:registry": "node packages/registry/scripts/build.mjs",
    "test": "npm run test --workspaces --if-present",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:lint": "forge lint --root contracts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "viem": "^2.56.3"
  },
  "overrides": {
    "zod@<4.6.6": "^4.6.6",
    "vite@<=6.4.3": "^6.4.4",
    "vite@<=6.4.2": "^6.4.4",
    "vite@<=6.4.1": "^6.4.4",
    "hono@>=4.12.4 <4.13.11": "^4.13.11",
    "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
    "proxy-addr@>=1.1.0 <2.0.8": "^2.0.8",
    "esbuild@<=0.24.2": "^0.25.0"
  }
}
